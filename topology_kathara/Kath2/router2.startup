# Interface Configuration
# -----------------------
# FastEthernet0/0 (Server Room)
ip addr add 1.0.0.1/8 dev eth0
ip link set dev eth0 up

# FastEthernet1/0 (Internet Lab)
ip addr add 128.168.0.1/16 dev eth1
ip link set dev eth1 up

# Serial2/0 (WAN Link to Router1)
# Matches Router1's 20.20.0.1 subnet
ip addr add 20.20.0.2/8 dev eth2
ip link set dev eth2 up

# Routing Configuration (RIP)
# ---------------------------
# 1. Enable RIP daemon
echo "ripd=yes" >> /etc/frr/daemons
/etc/init.d/frr start

# 2. Configure RIP via vtysh
# Advertising: 1.0.0.0, 20.0.0.0, 128.168.0.0 [cite: 74]
vtysh -c "configure terminal" \
      -c "router rip" \
      -c "version 2" \
      -c "network 1.0.0.0/8" \
      -c "network 128.168.0.0/16" \
      -c "network 20.0.0.0/8" \
      -c "exit" \