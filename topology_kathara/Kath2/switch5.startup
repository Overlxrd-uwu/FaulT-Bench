# Create the Bridge
brctl addbr br0

# Add Interfaces
# eth0 -> Connects to Router 2
# eth1 -> Connects to Internet Lab LAN
brctl addif br0 eth0
brctl addif br0 eth1

# Enable Spanning Tree Protocol (Matches 'spanning-tree mode pvst')
brctl stp br0 on

# Bring Interfaces UP
ip link set dev eth0 up
ip link set dev eth1 up
ip link set dev br0 up