# Interface Configuration
# -----------------------
# FastEthernet0/0 (IT Department)
ip addr add 192.168.1.1/24 dev eth0
ip link set dev eth0 up

# FastEthernet1/0 (Computer Department)
ip addr add 192.168.2.1/24 dev eth1
ip link set dev eth1 up

# Serial2/0 (WAN Link to Router1)
# Cisco: clock rate 2000000 (Ignored in Linux)
ip addr add 10.10.0.1/8 dev eth2
ip link set dev eth2 up

# Routing Configuration (RIP)
# ---------------------------
# 1. Enable RIP and Zebra daemons
echo "ripd=yes" >> /etc/frr/daemons
/etc/init.d/frr start

# 2. Configure RIP via vtysh
# We use 'version 2' for better compatibility with modern networks
vtysh -c "configure terminal" \
      -c "router rip" \
      -c "version 2" \
      -c "network 192.168.1.0/24" \
      -c "network 192.168.2.0/24" \
      -c "network 10.0.0.0/8" \
      -c "exit"