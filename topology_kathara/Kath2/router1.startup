# Interface Configuration
# -----------------------
# FastEthernet0/0 (Office/Exam Cell)
ip addr add 192.168.3.1/24 dev eth0
ip link set dev eth0 up

# FastEthernet1/0 (Principle Room)
ip addr add 192.168.4.1/24 dev eth1
ip link set dev eth1 up

# Serial2/0 (WAN Link to Router0)
# Matches Router0's 10.10.0.1 subnet
ip addr add 10.10.0.2/8 dev eth2
ip link set dev eth2 up

# Serial3/0 (WAN Link to Router2)
# New link for the next step
ip addr add 20.20.0.1/8 dev eth3
ip link set dev eth3 up

# Routing Configuration (RIP)
# ---------------------------
# 1. Enable RIP daemon
echo "ripd=yes" >> /etc/frr/daemons
/etc/init.d/frr start

# 2. Configure RIP via vtysh
vtysh -c "configure terminal" \
      -c "router rip" \
      -c "version 2" \
      -c "network 192.168.3.0/24" \
      -c "network 192.168.4.0/24" \
      -c "network 10.0.0.0/8" \
      -c "network 20.0.0.0/8" \
      -c "exit"