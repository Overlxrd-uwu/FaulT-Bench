# Create a Bridge named 'br0'
brctl addbr br0

# Add interfaces to the bridge
# eth0 connects to Router0
# eth1 connects to the IT Dept LAN
brctl addif br0 eth0
brctl addif br0 eth1

# Enable Spanning Tree Protocol (Matches 'spanning-tree mode pvst')
brctl stp br0 on

# Bring everything UP
ip link set dev eth0 up
ip link set dev eth1 up
ip link set dev br0 up

# Note: No IP address is assigned, matching 'interface Vlan1 shutdown'