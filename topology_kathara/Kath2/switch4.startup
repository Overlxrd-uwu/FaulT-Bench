# Create the Bridge
brctl addbr br0

# Add Interfaces
# eth0 -> Connects to Router 2
# eth1 -> Connects to Server LAN
brctl addif br0 eth0
brctl addif br0 eth1

# Enable Spanning Tree Protocol
brctl stp br0 on

# Bring Interfaces UP
ip link set dev eth0 up
ip link set dev eth1 up
ip link set dev br0 up

# Note: No IP address assigned, matching 'interface Vlan1 shutdown' [cite: 95]