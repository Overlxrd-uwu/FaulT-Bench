# ----------------------------------------------------
# Device: Switch6 (Layer 2 Switching)
# Translation: Map physical interfaces to a bridge
# ----------------------------------------------------

# Create default bridge (Switch Fabric)
ip link add br0 type bridge
ip link set br0 up

# ---------------------------
# Interface: FastEthernet0/1
# ---------------------------
ip link set eth0 up
ip link set eth0 master br0

# ---------------------------
# Interface: FastEthernet1/1
# ---------------------------
ip link set eth1 up
ip link set eth1 master br0

# ---------------------------
# Interface: FastEthernet2/1
# ---------------------------
ip link set eth2 up
ip link set eth2 master br0

# ---------------------------
# Interface: FastEthernet3/1
# ---------------------------
ip link set eth3 up
ip link set eth3 master br0

# ---------------------------
# Interface: FastEthernet4/1
# ---------------------------
ip link set eth4 up
ip link set eth4 master br0

# ---------------------------
# Interface: FastEthernet5/1
# ---------------------------
ip link set eth5 up
ip link set eth5 master br0

# ---------------------------
# Interface: Vlan1
# Source: no ip address, shutdown
# ---------------------------
# No IP configuration applied to br0.