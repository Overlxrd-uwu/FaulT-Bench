# Enable IP forwarding
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# Interface: FastEthernet0/0
# ---------------------------
# Source: ip address 192.168.200.1 255.255.255.0
ip link set eth0 up
ip address add 192.168.200.1/24 dev eth0

# ---------------------------
# Interface: FastEthernet1/0 (Shutdown)
# ---------------------------
# Source: shutdown
ip link set eth1 down

# ---------------------------
# Interface: Serial2/0 (Shutdown)
# ---------------------------
# Source: shutdown
ip link set eth2 down

# ---------------------------
# Interface: Serial3/0 (Shutdown)
# ---------------------------
# Source: shutdown
ip link set eth3 down

# ---------------------------
# Interface: FastEthernet4/0
# ---------------------------
# Source: ip address 192.168.15.2 255.255.255.0
ip link set eth4 up
ip address add 192.168.15.2/24 dev eth4

# ---------------------------
# Interface: FastEthernet5/0
# ---------------------------
# Source: ip address 172.25.1.1 255.255.255.0
ip link set eth5 up
ip address add 172.25.1.1/24 dev eth5

# ---------------------------
# Static Routes
# ---------------------------
# Source: ip route 0.0.0.0 0.0.0.0 172.25.1.2
ip route add default via 172.25.1.2

# ---------------------------
# Routing Protocol: RIPv2
# ---------------------------
# Source: router rip, version 2
sed -i 's/ripd=no/ripd=yes/g' /etc/frr/daemons
/etc/init.d/frr start

vtysh -c "configure terminal" \
-c "router rip" \
-c "version 2" \
-c "network 172.25.0.0/16" \
-c "network 192.168.15.0/24" \
-c "network 192.168.200.0/24" \
-c "exit" \
-c "exit"