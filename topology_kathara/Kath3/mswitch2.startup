# Enable IP forwarding (Standard for L3 switches)
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# Create Bridges (VLANs)
# ---------------------------
ip link add br_vlan1 type bridge
ip link set br_vlan1 up

ip link add br_vlan50 type bridge
ip link set br_vlan50 up

ip link add br_vlan51 type bridge
ip link set br_vlan51 up

# ---------------------------
# Configure VLAN 50 Access Ports
# ---------------------------
# Fa0/1 (eth0), Fa0/2 (eth1), Fa0/4 (eth3)

# eth0
ip link set eth0 up
ip link set eth0 master br_vlan50

# eth1
ip link set eth1 up
ip link set eth1 master br_vlan50

# eth3
ip link set eth3 up
ip link set eth3 master br_vlan50

# ---------------------------
# Configure VLAN 51 Access Ports
# ---------------------------
# Fa0/3 (eth2), Fa0/5 (eth4)

# eth2
ip link set eth2 up
ip link set eth2 master br_vlan51

# eth4
ip link set eth4 up
ip link set eth4 master br_vlan51

# ---------------------------
# Configure Default Ports (VLAN 1)
# ---------------------------
# Fa0/6 (eth5) through Gi0/2 (eth25)
# Using a loop for efficiency to cover eth5 to eth25

for i in $(seq 5 25); do
    ip link set eth$i up
    ip link set eth$i master br_vlan1
done

# ---------------------------
# SVI Configuration
# ---------------------------
# interface Vlan1 is shutdown in config, so no IP is assigned to br_vlan1.