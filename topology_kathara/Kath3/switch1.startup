# Enable IP forwarding
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# Create Bridges (VLANs)
# ---------------------------
ip link add br_vlan10 type bridge
ip link set br_vlan10 up

ip link add br_vlan20 type bridge
ip link set br_vlan20 up

# ---------------------------
# Configure Trunks (Tagging)
# ---------------------------
# eth0 (Fa0/1), eth8 (Fa8/1), eth9 (Fa9/1) are trunks

ip link set eth0 up
ip link set eth8 up
ip link set eth9 up

# VLAN 10 Sub-interfaces for Trunks
ip link add link eth0 name eth0.10 type vlan id 10
ip link add link eth8 name eth8.10 type vlan id 10
ip link add link eth9 name eth9.10 type vlan id 10

ip link set eth0.10 up
ip link set eth8.10 up
ip link set eth9.10 up

ip link set eth0.10 master br_vlan10
ip link set eth8.10 master br_vlan10
ip link set eth9.10 master br_vlan10

# VLAN 20 Sub-interfaces for Trunks
ip link add link eth0 name eth0.20 type vlan id 20
ip link add link eth8 name eth8.20 type vlan id 20
ip link add link eth9 name eth9.20 type vlan id 20

ip link set eth0.20 up
ip link set eth8.20 up
ip link set eth9.20 up

ip link set eth0.20 master br_vlan20
ip link set eth8.20 master br_vlan20
ip link set eth9.20 master br_vlan20

# ---------------------------
# Configure Access Ports
# ---------------------------
# VLAN 10 Access: eth1, eth2, eth3, eth4, eth5, eth6
ip link set eth1 up
ip link set eth1 master br_vlan10

ip link set eth2 up
ip link set eth2 master br_vlan10

ip link set eth3 up
ip link set eth3 master br_vlan10

ip link set eth4 up
ip link set eth4 master br_vlan10

ip link set eth5 up
ip link set eth5 master br_vlan10

ip link set eth6 up
ip link set eth6 master br_vlan10

# VLAN 20 Access: eth7
ip link set eth7 up
ip link set eth7 master br_vlan20