# Enable IP forwarding (Standard for L3 switches, though routing is currently disabled in config)
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# Create Bridges (VLANs)
# ---------------------------
# Native VLAN
ip link add br_vlan1 type bridge
ip link set br_vlan1 up

# VLAN 10 (Inferred from neighbor switches)
ip link add br_vlan10 type bridge
ip link set br_vlan10 up

# VLAN 20 (Inferred from neighbor switches)
ip link add br_vlan20 type bridge
ip link set br_vlan20 up

# ---------------------------
# Configure Trunks
# ---------------------------
# Fa0/1 (eth0), Fa0/3 (eth2), Fa0/5 (eth4)

# Bring up physical interfaces
ip link set eth0 up
ip link set eth2 up
ip link set eth4 up

# --- VLAN 10 Tagging ---
ip link add link eth0 name eth0.10 type vlan id 10
ip link add link eth2 name eth2.10 type vlan id 10
ip link add link eth4 name eth4.10 type vlan id 10

ip link set eth0.10 up
ip link set eth2.10 up
ip link set eth4.10 up

ip link set eth0.10 master br_vlan10
ip link set eth2.10 master br_vlan10
ip link set eth4.10 master br_vlan10

# --- VLAN 20 Tagging ---
ip link add link eth0 name eth0.20 type vlan id 20
ip link add link eth2 name eth2.20 type vlan id 20
ip link add link eth4 name eth4.20 type vlan id 20

ip link set eth0.20 up
ip link set eth2.20 up
ip link set eth4.20 up

ip link set eth0.20 master br_vlan20
ip link set eth2.20 master br_vlan20
ip link set eth4.20 master br_vlan20

# --- Native VLAN (Untagged) on Trunks ---
# We add the physical interface to br_vlan1 for native traffic
ip link set eth0 master br_vlan1
ip link set eth2 master br_vlan1
ip link set eth4 master br_vlan1

# ---------------------------
# Configure Default Access Ports (VLAN 1)
# ---------------------------
# All other ports are unconfigured, defaulting to VLAN 1
# List: eth1, eth3, eth5...eth25 (skipping trunks eth0, eth2, eth4)

for i in 1 3 $(seq 5 25); do
    ip link set eth$i up
    ip link set eth$i master br_vlan1
done