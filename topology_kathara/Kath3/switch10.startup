# ----------------------------------------------------
# Device: Switch10 (Layer 2 Switching)
# Translation: Map physical interfaces to a bridge
# ----------------------------------------------------

# Create default bridge (Switch Fabric)
ip link add br0 type bridge
ip link set br0 up

# ---------------------------
# Interfaces: FastEthernet0/1 to FastEthernet9/1
# ---------------------------

# eth0
ip link set eth0 up
ip link set eth0 master br0

# eth1
ip link set eth1 up
ip link set eth1 master br0

# eth2
ip link set eth2 up
ip link set eth2 master br0

# eth3
ip link set eth3 up
ip link set eth3 master br0

# eth4
ip link set eth4 up
ip link set eth4 master br0

# eth5
ip link set eth5 up
ip link set eth5 master br0

# eth6
ip link set eth6 up
ip link set eth6 master br0

# eth7
ip link set eth7 up
ip link set eth7 master br0

# eth8
ip link set eth8 up
ip link set eth8 master br0

# eth9
ip link set eth9 up
ip link set eth9 master br0

# ---------------------------
# Interface: Vlan1
# Source: no ip address, shutdown
# ---------------------------
# No IP configuration applied.