# Enable IP forwarding (Essential for a Router)
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# Interface: FastEthernet0/0 (Physical & Sub-interfaces)
# ---------------------------
# Physical Interface (Native VLAN)
# Source: ip address 192.168.1.1 255.255.255.0
ip link set eth0 up
ip address add 192.168.1.1/24 dev eth0

# Sub-interface: FastEthernet0/0.1 (VLAN 10)
# Source: encapsulation dot1Q 10, ip address 172.16.10.1
ip link add link eth0 name eth0.10 type vlan id 10
ip link set eth0.10 up
ip address add 172.16.10.1/24 dev eth0.10

# Sub-interface: FastEthernet0/0.2 (VLAN 20)
# Source: encapsulation dot1Q 20, ip address 172.16.20.1
ip link add link eth0 name eth0.20 type vlan id 20
ip link set eth0.20 up
ip address add 172.16.20.1/24 dev eth0.20

# ---------------------------
# Interface: FastEthernet1/0 (Shutdown)
# ---------------------------
# Source: shutdown
ip link set eth1 down

# ---------------------------
# Interface: Serial2/0
# ---------------------------
# Source: ip address 10.16.1.1 255.255.255.0
ip link set eth2 up
ip address add 10.16.1.1/24 dev eth2

# ---------------------------
# Interface: Serial3/0 (Shutdown)
# ---------------------------
# Source: shutdown
ip link set eth3 down

# ---------------------------
# Interface: FastEthernet4/0
# ---------------------------
# Source: ip address 172.20.1.1 255.255.255.0
ip link set eth4 up
ip address add 172.20.1.1/24 dev eth4

# ---------------------------
# Interface: FastEthernet5/0 (Shutdown)
# ---------------------------
# Source: shutdown
ip link set eth5 down

# ---------------------------
# Static Routes
# ---------------------------
# Source: ip route 172.18.50.0 255.255.255.0 10.16.1.2
ip route add 172.18.50.0/24 via 10.16.1.2

# Source: ip route 172.18.51.0 255.255.255.0 10.16.1.2
ip route add 172.18.51.0/24 via 10.16.1.2

# ---------------------------
# Routing Protocol: RIPv2
# ---------------------------
# Using FRR (vtysh) to configure RIP
sed -i 's/ripd=no/ripd=yes/g' /etc/frr/daemons
/etc/init.d/frr start

vtysh -c "configure terminal" \
-c "router rip" \
-c "version 2" \
-c "network 10.0.0.0/8" \
-c "network 172.16.0.0/16" \
-c "network 172.20.0.0/16" \
-c "network 192.168.1.0/24" \
-c "exit" \
-c "exit"