# Enable IP forwarding
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# Interface: FastEthernet0/0 (Shutdown)
# ---------------------------
# Source: shutdown [cite: 79]
ip link set eth0 down

# ---------------------------
# Interface: FastEthernet1/0 (Shutdown)
# ---------------------------
# Source: shutdown 
ip link set eth1 down

# ---------------------------
# Interface: Serial2/0
# ---------------------------
# Source: ip address 10.20.1.2 255.255.255.0 
ip link set eth2 up
ip address add 10.20.1.2/24 dev eth2

# ---------------------------
# Interface: Serial3/0 (Shutdown)
# ---------------------------
# Source: shutdown 
ip link set eth3 down

# ---------------------------
# Interface: FastEthernet4/0
# ---------------------------
# Source: ip address 192.168.100.1 255.255.255.0 
ip link set eth4 up
ip address add 192.168.100.1/24 dev eth4

# ---------------------------
# Interface: FastEthernet5/0 (Shutdown)
# ---------------------------
# Source: shutdown 
ip link set eth5 down

# ---------------------------
# Static Routes
# ---------------------------
# Source: ip route 172.18.50.0 255.255.255.0 192.168.100.2 
ip route add 172.18.50.0/24 via 192.168.100.2

# Source: ip route 172.18.51.0 255.255.255.0 192.168.100.2 
ip route add 172.18.51.0/24 via 192.168.100.2

# ---------------------------
# Routing Protocol: RIPv2
# ---------------------------
# Source: router rip, version 2, network 10.0.0.0, network 192.168.100.0 
sed -i 's/ripd=no/ripd=yes/g' /etc/frr/daemons
/etc/init.d/frr start

vtysh -c "configure terminal" \
-c "router rip" \
-c "version 2" \
-c "network 10.0.0.0/8" \
-c "network 192.168.100.0/24" \
-c "exit" \
-c "exit"