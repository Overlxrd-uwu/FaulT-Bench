# Enable IP forwarding
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# Interface: FastEthernet0/0
# ---------------------------
# Source: ip address 172.18.50.254 255.255.255.0
ip link set eth0 up
ip address add 172.18.50.254/24 dev eth0

# ---------------------------
# Interface: FastEthernet1/0
# ---------------------------
# Source: ip address 172.18.51.254 255.255.255.0
ip link set eth1 up
ip address add 172.18.51.254/24 dev eth1

# ---------------------------
# Interface: Serial2/0
# ---------------------------
# Source: ip address 10.50.1.2 255.255.255.0
ip link set eth2 up
ip address add 10.50.1.2/24 dev eth2

# ---------------------------
# Interface Shutdowns
# ---------------------------
ip link set eth3 down
ip link set eth4 down
ip link set eth5 down

# ---------------------------
# Static Routes
# ---------------------------
# Source: ip route 0.0.0.0 0.0.0.0 10.50.1.1 150
# Note: Linux metric/distance is handled differently, but we add the route normally.
ip route add default via 10.50.1.1 metric 150

# ---------------------------
# ACL Translation (Cisco -> iptables)
# ---------------------------
# Source: ip access-group 110 in (on Serial2/0 / eth2)
# Logic: We filter packets entering eth2 that are being forwarded.

# 1. Permit TCP from 172.16.10.0/24 to 172.18.51.1 port 80
iptables -A FORWARD -i eth2 -p tcp -s 172.16.10.0/24 -d 172.18.51.1 --dport 80 -j ACCEPT

# 2. Deny TCP any any
iptables -A FORWARD -i eth2 -p tcp -j DROP

# 3. Deny UDP any any
iptables -A FORWARD -i eth2 -p udp -j DROP

# 4. Implicit Deny (Standard ACL behavior blocks everything else not permitted)
# However, Cisco standard ACLs allow other protocols (like ICMP) if not explicitly denied.
# Given the explicit "deny tcp" and "deny udp", ICMP might pass. 
# If you want STRICT Cisco behavior where the list ends with implicit deny all:
iptables -A FORWARD -i eth2 -j DROP

# ---------------------------
# Routing Protocol: RIP
# ---------------------------
# Source: router rip, network 10.0.0.0
# Note: No "version 2" specified in this file, but usually v2 is preferred.
# I will use standard FRR defaults which generally support v2.
sed -i 's/ripd=no/ripd=yes/g' /etc/frr/daemons
/etc/init.d/frr start

vtysh -c "configure terminal" \
-c "router rip" \
-c "network 10.0.0.0/8" \
-c "exit" \
-c "exit"