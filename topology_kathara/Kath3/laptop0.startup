# Laptop0 — Location A, Switch1 access, VLAN 20 (172.16.20.0/24)
# Only one VLAN-20 access port (eth7) exists on switch1 — only 1 host of the
# diagram's VLAN-20 cluster (PC6-10, Laptop0-1) is attached here.
ip link set dev eth0 up
ip addr add 172.16.20.10/24 dev eth0
ip route add default via 172.16.20.1
