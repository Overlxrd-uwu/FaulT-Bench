# ----------------------------------------------------
# Device: Switch2
# Source: Switch2_running-config.txt
# ----------------------------------------------------

# Enable packet forwarding
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# Create Bridges (VLANs)
# ---------------------------
# VLAN 1 (Native)
ip link add br_vlan1 type bridge
ip link set br_vlan1 up

# VLAN 20 (Access Data)
ip link add br_vlan20 type bridge
ip link set br_vlan20 up

# ---------------------------
# Configure Trunks (Fa0/1, Fa0/2, Fa0/3)
# ---------------------------
# Source: switchport mode trunk
# Interfaces: eth0, eth1, eth2

for port in 0 1 2; do
    ip link set eth$port up
    
    # --- VLAN 20 (Tagged) ---
    ip link add link eth$port name eth$port.20 type vlan id 20
    ip link set eth$port.20 up
    ip link set eth$port.20 master br_vlan20
    
    # --- VLAN 1 (Native/Untagged) ---
    ip link set eth$port master br_vlan1
done

# ---------------------------
# Configure Access Ports (VLAN 20)
# ---------------------------
# Source: switchport access vlan 20
# Interfaces: eth3 (Fa0/4), eth4 (Fa0/5), eth5 (Fa0/6), eth6 (Fa0/7)

for port in 3 4 5 6; do
    ip link set eth$port up
    ip link set eth$port master br_vlan20
done

# ---------------------------
# Configure Unused Ports (VLAN 1)
# ---------------------------
# Interfaces: eth7 - eth25
for i in $(seq 7 25); do
    ip link set eth$i up
    ip link set eth$i master br_vlan1
done