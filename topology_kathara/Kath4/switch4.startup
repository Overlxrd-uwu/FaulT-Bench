# ----------------------------------------------------
# Device: Switch4
# Source: Switch4_running-config.txt
# ----------------------------------------------------

# Enable packet forwarding
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# Create Bridges (VLANs)
# ---------------------------
# VLAN 1 (Native)
ip link add br_vlan1 type bridge
ip link set br_vlan1 up

# VLAN 5 (Access Data)
ip link add br_vlan5 type bridge
ip link set br_vlan5 up

# VLAN 6 (Access Data)
ip link add br_vlan6 type bridge
ip link set br_vlan6 up

# ---------------------------
# Configure Trunk (Fa0/1)
# ---------------------------
# Source: switchport mode trunk
# Interface: eth0

ip link set eth0 up

# --- Tagged VLANs (5, 6) ---
ip link add link eth0 name eth0.5 type vlan id 5
ip link set eth0.5 up
ip link set eth0.5 master br_vlan5

ip link add link eth0 name eth0.6 type vlan id 6
ip link set eth0.6 up
ip link set eth0.6 master br_vlan6

# --- Native VLAN 1 ---
ip link set eth0 master br_vlan1

# ---------------------------
# Configure Access Ports (VLAN 5)
# ---------------------------
# Source: switchport access vlan 5
# Interfaces: eth1 (Fa0/2), eth2 (Fa0/3), eth3 (Fa0/4), eth6 (Fa0/7)

for port in 1 2 3 6; do
    ip link set eth$port up
    ip link set eth$port master br_vlan5
done

# ---------------------------
# Configure Access Ports (VLAN 6)
# ---------------------------
# Source: switchport access vlan 6
# Interfaces: eth4 (Fa0/5), eth5 (Fa0/6)

for port in 4 5; do
    ip link set eth$port up
    ip link set eth$port master br_vlan6
done

# ---------------------------
# Configure Unused Ports (VLAN 1)
# ---------------------------
# Interfaces: eth7 - eth25
for i in $(seq 7 25); do
    ip link set eth$i up
    ip link set eth$i master br_vlan1
done