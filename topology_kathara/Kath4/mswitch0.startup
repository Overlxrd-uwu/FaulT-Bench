# ----------------------------------------------------
# Device: MSwitch0 (Multilayer Switch)
# Source: Multilayer Switch0_running-config.txt
# ----------------------------------------------------

# Enable IP Forwarding (L3 Routing)
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# 1. Configure EtherChannel (Bonding)
# ---------------------------
# Source: interface Port-channel10 / mode on
# We use Linux Bonding Mode 0 (Balance-RR) to simulate static EtherChannel

modprobe bonding
ip link add bond0 type bond mode 0
ip link set bond0 up

# Add physical interfaces to the bond
ip link set eth0 down
ip link set eth1 down
ip link set eth0 master bond0
ip link set eth1 master bond0
ip link set eth0 up
ip link set eth1 up

# ---------------------------
# 2. Configure Switching Bridge
# ---------------------------
# This bridge acts as the "Switch Fabric". 
# It connects the Bond (Uplink) and the Downlinks (Switch1-4).

ip link add br0 type bridge
ip link set br0 up

# Add ports to the bridge
# bond0 (The EtherChannel)
ip link set bond0 master br0

# eth2, eth3, eth4, eth5 (Links to Access Switches)
for port in 2 3 4 5; do
    ip link set eth$port up
    ip link set eth$port master br0
done

# ---------------------------
# 3. Configure SVIs (VLAN Interfaces)
# ---------------------------
# These are the Layer 3 Gateways on top of the bridge.

# --- Vlan 1 (Mgmt/Uplink) ---
# Source: ip address 10.2.2.2 255.255.255.0
ip address add 10.2.2.2/24 dev br0

# --- Vlan 10 (Gateway) ---
# Source: ip address 172.16.10.254 255.255.255.0
ip link add link br0 name vlan10 type vlan id 10
ip link set vlan10 up
ip link set vlan10 address 00:01:97:e4:04:01
ip address add 172.16.10.254/24 dev vlan10

# --- Vlan 20 (Gateway) ---
# Source: ip address 172.16.20.254 255.255.255.0
ip link add link br0 name vlan20 type vlan id 20
ip link set vlan20 up
ip link set vlan20 address 00:01:97:e4:04:02
ip address add 172.16.20.254/24 dev vlan20

# --- Vlan 30 (Gateway) ---
# Source: ip address 172.16.30.254 255.255.255.0
ip link add link br0 name vlan30 type vlan id 30
ip link set vlan30 up
ip link set vlan30 address 00:01:97:e4:04:03
ip address add 172.16.30.254/24 dev vlan30

# ---------------------------
# 4. Configure OSPF
# ---------------------------
# Source: router ospf 1

# Enable OSPF daemon
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons
/etc/init.d/frr start

# Configure OSPF networks
vtysh -c "configure terminal" \
-c "router ospf" \
-c "network 10.2.2.0/24 area 0" \
-c "network 172.16.10.0/24 area 0" \
-c "network 172.16.20.0/24 area 0" \
-c "network 172.16.30.0/24 area 0" \
-c "exit" \
-c "exit"