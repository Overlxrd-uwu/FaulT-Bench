# ----------------------------------------------------
# Device: Switch3
# Source: Switch3_running-config.txt
# ----------------------------------------------------

# Enable packet forwarding
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# Create Bridges (VLANs)
# ---------------------------
# VLAN 1 (Native / Default)
ip link add br_vlan1 type bridge
ip link set br_vlan1 up

# VLAN 30 (Access Data)
ip link add br_vlan30 type bridge
ip link set br_vlan30 up

# ---------------------------
# Configure Access Ports (VLAN 30)
# ---------------------------
# Source: switchport access vlan 30
# Interfaces: eth2 (Fa0/3), eth3 (Fa0/4), eth4 (Fa0/5), eth5 (Fa0/6)

for port in 2 3 4 5; do
    ip link set eth$port up
    ip link set eth$port master br_vlan30
done

# ---------------------------
# Configure Default Ports (VLAN 1)
# ---------------------------
# Interfaces: eth0 (Fa0/1), eth1 (Fa0/2) and eth6-25
# Note: Fa0/1 and Fa0/2 are default in the config, so they go here.

# Uplinks (Fa0/1, Fa0/2) — eth0 is the trunk to mswitch0.
# Native VLAN 1 untagged on eth0:
ip link set eth0 up
ip link set eth0 master br_vlan1
ip link set eth1 up
ip link set eth1 master br_vlan1

# Tagged VLAN 30 trunk subinterface on eth0.
# Without it, switch3's VLAN-30 access ports were L2-isolated from mswitch0's
# vlan30 SVI, so PC12/13/14 couldn't reach their gateway 172.16.30.254).
ip link add link eth0 name eth0.30 type vlan id 30
ip link set eth0.30 up
ip link set eth0.30 master br_vlan30

# Remaining ports
for i in $(seq 6 25); do
    ip link set eth$i up
    ip link set eth$i master br_vlan1
done