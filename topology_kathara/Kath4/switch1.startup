#!/bin/bash
# ----------------------------------------------------
# Device: Switch1
# Role: L2 Access Switch (VLAN 10)
# ----------------------------------------------------

# 1. Enable Forwarding
sysctl -w net.ipv4.ip_forward=1

# 2. Create Bridges (The "Virtual Switches")
# ------------------------------------------
# VLAN 1 (Native)
ip link add br_vlan1 type bridge
ip link set br_vlan1 up

# VLAN 10 (Data - The Critical One)
ip link add br_vlan10 type bridge
ip link set br_vlan10 up

# 3. Configure Trunks (Uplinks)
# ------------------------------------------
# Interfaces: eth0 (Fa0/1), eth1 (Fa0/2)

for trunk in 0 1; do
    # Bring up physical interface
    ip link set eth$trunk up

    # -- Handle VLAN 10 (Tagged) --
    # Create the sub-interface (e.g., eth0.10)
    ip link add link eth$trunk name eth$trunk.10 type vlan id 10
    ip link set eth$trunk.10 up
    
    # Add it to the VLAN 10 bridge
    ip link set eth$trunk.10 master br_vlan10

    # -- Handle VLAN 1 (Native/Untagged) --
    # Add the bare interface to the VLAN 1 bridge
    ip link set eth$trunk master br_vlan1
done

# 4. Configure Access Ports (Downlinks)
# ------------------------------------------
# Interfaces: eth2, eth3, eth4, eth5 (All VLAN 10)
[cite_start]# [cite: 120, 121, 122]

for port in 2 3 4 5; do
    ip link set eth$port up
    # Add directly to the VLAN 10 bridge (Untagged)
    ip link set eth$port master br_vlan10
done

# 5. Configure Unused Ports (Optional)
# ------------------------------------------
# Maps remaining ports to default VLAN 1
for i in $(seq 6 25); do
    ip link set eth$i up
    ip link set eth$i master br_vlan1
done