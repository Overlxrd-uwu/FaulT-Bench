# ----------------------------------------------------
# Device: Router17
# Source: Router17_running-config.txt
# ----------------------------------------------------

# Enable IP Forwarding
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# 1. Configure Layer 3 EtherChannel (Port-channel10)
# ---------------------------
# Source: interface Port-channel10 / ip address 55.5.1.1
# Members: Fa0/0 (eth0), Fa0/1 (eth1)
# Mode: On -> Linux Bond Mode 0

modprobe bonding
ip link add bond0 type bond mode 0
ip link set bond0 up

# Add physical members
ip link set eth0 down
ip link set eth1 down
ip link set eth0 master bond0
ip link set eth1 master bond0
ip link set eth0 up
ip link set eth1 up

# Assign IP to the Bond Interface
ip address add 55.5.1.1/24 dev bond0

# ---------------------------
# 2. Configure Standard Interfaces
# ---------------------------

# Interface Ethernet0/0/0
# Source: ip address 10.1.0.2 255.255.255.0
ip link set eth2 up
ip address add 10.1.0.2/24 dev eth2

# Interface Ethernet0/1/0
# Source: ip address 192.168.144.2 255.255.255.0
ip link set eth3 up
ip address add 192.168.144.2/24 dev eth3

# Interface Ethernet1/0
# Source: ip address 172.29.10.2 255.255.255.0
ip link set eth4 up
ip address add 172.29.10.2/24 dev eth4

# Shutdown unused interfaces
ip link set eth5 down
ip link set eth6 down
ip link set eth7 down

# ---------------------------
# 3. Configure OSPF
# ---------------------------
# Source: router ospf 1 / network ... area 0

# Enable OSPF daemon
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons
/etc/init.d/frr start

# Configure OSPF via vtysh
vtysh -c "configure terminal" \
-c "router ospf" \
-c "network 10.1.0.0/24 area 0" \
-c "network 192.168.144.0/24 area 0" \
-c "network 172.29.10.0/24 area 0" \
-c "network 55.5.1.0/24 area 0" \
-c "exit" \
-c "exit"