# ----------------------------------------------------
# Device: Router1
# Source: Router1_running-config.txt
# ----------------------------------------------------

# Enable IP Forwarding
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# Configure Interfaces
# ---------------------------

# Interface Serial2/0
# Source: ip address 192.168.10.2 255.255.255.0
ip link set eth2 up
ip address add 192.168.10.2/24 dev eth2

# Interface Serial3/0
# Source: ip address 10.1.1.1 255.255.255.0
ip link set eth3 up
ip address add 10.1.1.1/24 dev eth3

# Shutdown unused interfaces
ip link set eth0 down
ip link set eth1 down
ip link set eth4 down
ip link set eth5 down

# ---------------------------
# Configure OSPF
# ---------------------------
# Source: router ospf 1 / network ... area 0

# Enable OSPF daemon
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons
/etc/init.d/frr start

# Configure OSPF via vtysh
vtysh -c "configure terminal" \
-c "router ospf" \
-c "network 192.168.10.0/24 area 0" \
-c "network 10.1.1.0/24 area 0" \
-c "exit" \
-c "exit"