# ----------------------------------------------------
# Device: Router11
# Source: Router11_running-config.txt
# ----------------------------------------------------

# Enable IP Forwarding
sysctl -w net.ipv4.ip_forward=1

# ---------------------------
# Configure Interfaces
# ---------------------------

# Interface FastEthernet0/0 (LAN)
# Source: ip address 10.1.0.1 255.255.255.0
ip link set eth0 up
ip address add 10.1.0.1/24 dev eth0

# Interface Serial2/0 (Link to Router1)
# Source: ip address 10.1.1.2 255.255.255.0
ip link set eth2 up
ip address add 10.1.1.2/24 dev eth2

# Shutdown unused interfaces
ip link set eth1 down
ip link set eth3 down
ip link set eth4 down
ip link set eth5 down

# ---------------------------
# Configure OSPF
# ---------------------------
# Source: router ospf 1 / network ... area 0

# Enable OSPF daemon
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons
/etc/init.d/frr start

# Configure OSPF via vtysh
vtysh -c "configure terminal" \
-c "router ospf" \
-c "network 10.1.1.0/24 area 0" \
-c "network 10.1.0.0/24 area 0" \
-c "exit" \
-c "exit"