# Physical Interfaces
ip link set eth0 up
ip addr add 103.1.1.2/8 dev eth0

# Loopback Interfaces — each /24 on its own dummy so FRR eigrpd advertises
# all four (it picks one prefix per Linux interface).
ip addr add 113.1.1.1/24 dev lo
ip link add lo1 type dummy && ip link set lo1 up && ip addr add 113.1.2.1/24 dev lo1
ip link add lo2 type dummy && ip link set lo2 up && ip addr add 113.1.3.1/24 dev lo2
ip link add lo3 type dummy && ip link set lo3 up && ip addr add 113.1.4.1/24 dev lo3

# Default route toward R11 — FRR eigrpd's `redistribute ospf` on R11 does
# not actually inject OSPF routes into EIGRP, so a static default via R11
# is needed for return paths.
ip route add default via 103.1.1.1 dev eth0

# Enable EIGRP daemon only
sed -i 's/eigrpd=no/eigrpd=yes/g' /etc/frr/daemons
# Ensure ospfd is off to save resources on this edge node
sed -i 's/ospfd=yes/ospfd=no/g' /etc/frr/daemons

# Start FRR
/etc/init.d/frr restart
