# Interface Mapping:
# eth0 -> Serial 5/0 (Connects to R1)
# eth1 -> Serial 5/1 (Connects to Neighbor 39.1.1.1)
# eth2 -> Serial 5/2 (Connects to Area 4)

ip addr add 1.1.1.2/8 dev eth0
ip addr add 23.1.1.1/8 dev eth1
ip addr add 21.1.1.1/8 dev eth2

ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

# Enable OSPF daemon
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons

# Start FRR
/etc/init.d/frr start