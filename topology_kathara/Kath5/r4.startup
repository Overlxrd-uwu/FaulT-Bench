# Interface Mapping:
# Serial5/3 -> eth0
# Serial6/0 -> eth1
# Serial6/1 -> eth2
# FastEthernet0/0 -> eth3
# Loopbacks -> lo:X

# Physical Interfaces
ip addr add 34.1.1.2/8 dev eth0
ip addr add 45.1.1.1/8 dev eth1
ip addr add 46.1.1.1/8 dev eth2
ip addr add 40.1.1.1/8 dev eth3

# Loopback Interfaces
# Note: In Linux, we add these as aliases to the 'lo' interface
ip addr add 14.1.1.1/24 dev lo
ip addr add 14.1.2.1/24 dev lo
ip addr add 14.1.3.1/24 dev lo
ip addr add 14.1.4.1/24 dev lo
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons
/etc/init.d/frr start