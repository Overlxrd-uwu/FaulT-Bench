# Interface Mapping:
# Serial5/0 -> eth0
# FastEthernet0/0 -> eth1

# Physical Interfaces
ip addr add 39.1.1.2/8 dev eth0
ip addr add 90.1.1.1/8 dev eth1

# Loopback Interfaces
ip addr add 19.1.1.1/24 dev lo
ip addr add 19.1.2.1/24 dev lo
ip addr add 19.1.3.1/24 dev lo
ip addr add 19.1.4.1/24 dev lo
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons
# Start FRR
/etc/init.d/frr start