# Interface Mapping:
# Serial6/0 -> eth0
# Serial6/2 -> eth1
# Serial6/3 -> eth2
# FastEthernet0/0 -> eth3
# Loopbacks -> lo

# Physical Interfaces
ip addr add 45.1.1.2/8 dev eth0
ip addr add 56.1.1.1/8 dev eth1
ip addr add 58.1.1.1/8 dev eth2
ip addr add 50.1.1.1/8 dev eth3

# Loopback Interfaces
ip addr add 15.1.1.1/24 dev lo
ip addr add 15.1.2.1/24 dev lo
ip addr add 15.1.3.1/24 dev lo
ip addr add 15.1.4.1/24 dev lo
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons
# Start FRR
/etc/init.d/frr start