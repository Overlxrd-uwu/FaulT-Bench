# Interface Mapping
# Serial6/3 -> eth0
# FastEthernet0/0 -> eth1

ip addr add 67.1.1.2/8 dev eth0
ip addr add 70.1.1.1/8 dev eth1

# Loopback Interfaces
ip addr add 17.1.1.1/24 dev lo
ip addr add 17.1.2.1/24 dev lo
ip addr add 17.1.3.1/24 dev lo
ip addr add 17.1.4.1/24 dev lo

# Enable OSPF daemon
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons

/etc/init.d/frr start
