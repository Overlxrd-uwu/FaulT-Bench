# Interface Mapping:
# Serial5/0 -> eth0
# FastEthernet0/0 -> eth1

ip addr add 112.1.1.2/8 dev eth0
ip addr add 120.1.1.1/8 dev eth1

# Loopback Interfaces.
# Each /24 lives on its own dummy interface — FRR eigrpd advertises one
# prefix per Linux interface (it ignores secondary IPs on `lo`), so each
# Cisco loopback gets its own L3 device here.
ip addr add 102.1.1.1/24 dev lo
ip link add lo1 type dummy && ip link set lo1 up && ip addr add 102.1.2.1/24 dev lo1
ip link add lo2 type dummy && ip link set lo2 up && ip addr add 102.1.3.1/24 dev lo2
ip link add lo3 type dummy && ip link set lo3 up && ip addr add 102.1.4.1/24 dev lo3

# Default route toward R11 — FRR eigrpd's `redistribute ospf` on R11 does
# not actually inject OSPF routes into EIGRP (silently no-op), so R12 has
# no learned path back to the OSPF side. A static default via R11 covers it.
ip route add default via 112.1.1.1 dev eth0

sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons
sed -i 's/eigrpd=no/eigrpd=yes/g' /etc/frr/daemons
/etc/init.d/frr start
