#!/bin/bash
# Interface addressing — all interfaces in the default VRF so that
# `redistribute eigrp` inside `router ospf` can pick up EIGRP routes.

# eth0 -> EIGRP AS 100 side (toward R12)
ip addr add 112.1.1.1/8 dev eth0

# eth1 -> OSPF Area 3 side (toward R1)
ip addr add 111.1.1.2/8 dev eth1

# eth2 -> EIGRP AS 300 side (toward R13)
ip addr add 103.1.1.1/8 dev eth2

# Enable OSPF + EIGRP daemons
sed -i 's/eigrpd=no/eigrpd=yes/g' /etc/frr/daemons
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons

/etc/init.d/frr start
