# Physical Interfaces
ip addr add 21.1.1.2/8 dev eth0
ip addr add 100.1.1.1/8 dev eth1

# Loopback Interfaces (R10)
# These must match the Cisco loopback definitions
ip addr add 110.1.1.1/24 dev lo
ip addr add 110.1.2.1/24 dev lo
ip addr add 110.1.3.1/24 dev lo
ip addr add 110.1.4.1/24 dev lo

ip link set eth0 up
ip link set eth1 up

# Enable OSPF
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons
/etc/init.d/frr start