# Interface Mapping:
# Serial5/0 -> eth0
# Serial5/1 -> eth1
# Serial5/2 -> eth2
# Serial5/3 -> eth3
# FastEthernet0/0 -> eth4
# FastEthernet2/0 -> eth5
# FastEthernet3/0 -> eth6

ip addr add 39.1.1.1/8 dev eth0
ip addr add 23.1.1.2/8 dev eth1
ip addr add 31.1.1.1/8 dev eth2
ip addr add 34.1.1.1/8 dev eth3
ip addr add 30.1.1.1/8 dev eth4
ip addr add 32.1.1.1/8 dev eth5
ip addr add 33.1.1.1/8 dev eth6
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons
/etc/init.d/frr start