# Interface Mapping:
# Serial5/0 -> eth0
# Serial5/1 -> eth1
# Serial5/2 -> eth2
# FastEthernet0/0 -> eth3
# FastEthernet2/0 -> eth4
# FastEthernet3/0 -> eth5

# [cite_start]Configure IP Addresses [cite: 1, 2, 3]
ip addr add 12.1.1.1/8 dev eth0
ip addr add 111.1.1.1/8 dev eth1
ip addr add 31.1.1.2/8 dev eth2
ip addr add 10.1.1.1/8 dev eth3
ip addr add 20.1.1.1/8 dev eth4
ip addr add 30.1.1.1/8 dev eth5
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons
# Start FRR (OSPF)
/etc/init.d/frr start