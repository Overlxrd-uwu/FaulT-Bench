#!/bin/bash
# SRV1 — Office B server segment (VLAN 30, 10.5.0.0/24).
# Hosts the campus DNS resolver at 10.5.0.4 that r1's DHCP hands out
# (option domain-name-servers 10.5.0.4) and that r1 1:1-NATs to 203.0.113.113.
# Restored 2026-06-25 to de-contaminate the kath1 "Internet-down" negative
# control (the original port dropped this host but kept every reference to it).

ip link set dev eth0 up
ip addr add 10.5.0.4/24 dev eth0
ip route add default via 10.5.0.1

# Resolve via the local authoritative server.
echo "nameserver 127.0.0.1" > /etc/resolv.conf

# Start BIND9 — authoritative for jeremysitlab.com, answering on all interfaces.
named -c /etc/bind/named.conf
