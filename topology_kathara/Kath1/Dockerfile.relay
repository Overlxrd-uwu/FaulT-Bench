# Builds `frr-with-vrrp-relay` -- the ONLY custom image in the benchmark, used by
# Kath1's four VRRP distribution switches (dswa1, dswa2, dswb1, dswb2). Everything else
# (Kath2-5 + the NIKA topologies) runs on stock Docker Hub images.
#
# Self-contained: three packages on top of the stock kathara/frr image --
#   keepalived      VRRP virtual IPs   (the .startup runs `/etc/init.d/keepalived start`)
#   isc-dhcp-relay  the `dhcrelay` binary that forwards DHCP across VLANs to r1
#   ipvsadm         keepalived's IPVS companion (a *recommended* dep that
#                   --no-install-recommends would skip); included for exact parity
#                   with the original image.
#
# Build (from this directory):
#   docker build -t frr-with-vrrp-relay -f Dockerfile.relay .
FROM kathara/frr
RUN apt-get update && \
    apt-get install -y --no-install-recommends keepalived isc-dhcp-relay ipvsadm && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
