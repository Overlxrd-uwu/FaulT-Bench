$TTL 604800
@   IN  SOA srv1.jeremysitlab.com. admin.jeremysitlab.com. (
        2          ; Serial
        604800     ; Refresh
        86400      ; Retry
        2419200    ; Expire
        604800 )   ; Negative Cache TTL
@       IN  NS  srv1.jeremysitlab.com.
@       IN  A   10.5.0.4
srv1    IN  A   10.5.0.4
; Wildcard so any campus hostname resolves to the server (lab convenience).
*       IN  A   10.5.0.4
