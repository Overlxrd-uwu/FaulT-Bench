# Laptop1 — Office A WiFi laptop, modeled as wired into ASW-A1 eth1 on VLAN 40.
# Use DHCP (relayed via DSW-A1/A2 -> R1). Fallback to static if DHCP fails.

ip link set dev eth0 up
dhclient -1 -timeout 30 -v eth0 2>/dev/null || ip addr add 10.6.0.100/24 dev eth0
ip route show default 2>/dev/null | grep -q default || ip route add default via 10.6.0.1

# Campus DNS fallback: dhclient should deliver it (r1 dhcpd option
# domain-name-servers), but guarantee it in case the lease/hook fails.
grep -q nameserver /etc/resolv.conf 2>/dev/null || echo "nameserver 10.5.0.4" > /etc/resolv.conf
