# csw2.startup

# --- A. Interface Setup ---
# 1. WAN Link (Gi1/0/1 -> eth0)
ip link set dev eth0 up
ip addr add 10.0.0.38/30 dev eth0
# IPv6 Address (Static assignment)
ip -6 addr add 2001:db8:a2::1/64 dev eth0 2>/dev/null || true

# 2. Port-Channel to Peer (Gi1/0/2, Gi1/0/3 -> bond0)
ip link add bond0 type bond mode 802.3ad
ip link set dev eth1 down
ip link set dev eth2 down
ip link set dev eth1 master bond0
ip link set dev eth2 master bond0
ip link set dev bond0 up
ip link set dev eth1 up
ip link set dev eth2 up
# Port-channel1 IP
ip addr add 10.0.0.42/30 dev bond0
ip -6 link set dev bond0 up

# 3. Downlinks to DSWs (eth3 - eth6)
# Gi1/1/1 -> DSW-A1
ip link set dev eth3 up
ip addr add 10.0.0.61/30 dev eth3

# Gi1/1/2 -> DSW-A2
ip link set dev eth4 up
ip addr add 10.0.0.65/30 dev eth4

# Gi1/1/3 -> DSW-B1
ip link set dev eth5 up
ip addr add 10.0.0.69/30 dev eth5

# Gi1/1/4 -> DSW-B2
ip link set dev eth6 up
ip addr add 10.0.0.73/30 dev eth6

# --- B. Loopback ---
ip addr add 10.0.0.78/32 dev lo

# --- C. Start Services ---
# **NEW: Enable OSPF Daemon**
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons

/etc/init.d/frr start