#!/bin/bash
# dswa1.startup — VLAN-aware bridge rewrite
# eth0/1/2 = trunks to ASW-A1/2/3, eth3+eth4 = LACP bond peer link to DSW-A2,
# eth5/eth6 = L3 uplinks to CSW1/CSW2.

sysctl -w net.ipv4.ip_forward=1 > /dev/null

for i in 0 1 2 3 4 5 6; do ip link set dev eth$i up; done

# --- LACP bond (peer link to DSW-A2) ---
ip link add bond0 type bond mode 802.3ad
ip link set eth3 down; ip link set eth3 master bond0
ip link set eth4 down; ip link set eth4 master bond0
ip link set bond0 up

# --- VLAN-aware bridge ---
ip link add name br0 type bridge vlan_filtering 1 vlan_default_pvid 0 stp_state 1
ip link set br0 up
# DSW-A1 = STP root for Office A (lowest priority)
ip link set br0 type bridge priority 4096

# --- Trunk ports: eth0/1/2 (to ASWs) + bond0 (peer) ---
for trunk in eth0 eth1 eth2 bond0; do
  ip link set $trunk master br0
  bridge vlan del dev $trunk vid 1 2>/dev/null
  for vid in 10 20 40 99; do bridge vlan add dev $trunk vid $vid; done
done

# Self ports for SVIs
for vid in 10 20 40 99; do bridge vlan add dev br0 vid $vid self; done

# --- SVIs (VRRP-base IPs; VIPs added by keepalived) ---
ip link add link br0 name br0.10 type vlan id 10
ip link set br0.10 up
ip addr add 10.1.0.2/24 dev br0.10

ip link add link br0 name br0.20 type vlan id 20
ip link set br0.20 up
ip addr add 10.2.0.2/24 dev br0.20

ip link add link br0 name br0.40 type vlan id 40
ip link set br0.40 up
ip addr add 10.6.0.2/24 dev br0.40

ip link add link br0 name br0.99 type vlan id 99
ip link set br0.99 up
ip addr add 10.0.0.2/28 dev br0.99

# --- L3 uplinks to core ---
ip addr add 10.0.0.46/30 dev eth5
ip addr add 10.0.0.62/30 dev eth6

# --- Services ---
/etc/init.d/keepalived start
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons
/etc/init.d/frr start

# --- DHCP relay (Office A primary; dswa2 doesn't run relay to avoid dual-relay collision) ---
dhcrelay -i br0.10 -i br0.20 -i br0.40 -i br0.99 -i eth5 -i eth6 10.0.0.76 || true

# --- ACL: OfficeA_to_OfficeB (mirrors Cisco named ACL) ---
iptables -A FORWARD -i br0.10 -p icmp -s 10.1.0.0/24 -d 10.3.0.0/24 -j ACCEPT
iptables -A FORWARD -i br0.10 -s 10.1.0.0/24 -d 10.3.0.0/24 -j DROP
