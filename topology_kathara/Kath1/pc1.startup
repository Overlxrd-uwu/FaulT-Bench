# PC1 — Office A, ASW-A2 eth0 (VLAN 10 untagged).

ip link set dev eth0 up
ip addr add 10.1.0.100/24 dev eth0
ip route add default via 10.1.0.1

# Campus DNS (srv1). r1's DHCP hands this out; statically-addressed hosts
# must set it explicitly or /etc/resolv.conf stays empty (found 2026-07-04).
echo "nameserver 10.5.0.4" > /etc/resolv.conf
