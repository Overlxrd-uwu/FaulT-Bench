# ispa.startup

# --- A. Interface Setup ---
# 1. Link to R1 (Gi0/0/0 -> eth0)
ip link set dev eth0 up
ip addr add 203.0.113.1/30 dev eth0

# Safe IPv6 Addition (Bypass if denied)
ip -6 addr add 2001:db8:a::1/64 dev eth0 2>/dev/null || true

# 2. Link to ISPB (Gi0/1/0 -> eth1)
ip link set dev eth1 up
ip addr add 192.0.2.1/30 dev eth1

# --- B. Loopbacks (Simulating Internet Services) ---
# We add these as secondary addresses to the Loopback interface
ip addr add 172.253.62.100/32 dev lo  # google.com
ip addr add 152.250.31.93/32 dev lo   # youtube.com
ip addr add 66.235.200.145/32 dev lo  # jeremysitlab.com
ip addr add 216.239.35.0/32 dev lo    # time1.google.com

# --- C. Routing ---
# Static Default Route to R1 (As per config source 79)
ip route add default via 203.0.113.2
# IPv6 Default Route
ip -6 route add default via 2001:db8:a::2 2>/dev/null || true

# --- D. Security (ACL Translation) ---
# Block private IP ranges from entering eth0 (Ingress Filtering)
# 10.0.0.0/8
iptables -A INPUT -i eth0 -s 10.0.0.0/8 -j DROP
iptables -A FORWARD -i eth0 -s 10.0.0.0/8 -j DROP
# 172.16.0.0/12
iptables -A INPUT -i eth0 -s 172.16.0.0/12 -j DROP
iptables -A FORWARD -i eth0 -s 172.16.0.0/12 -j DROP
# 192.168.0.0/16
iptables -A INPUT -i eth0 -s 192.168.0.0/16 -j DROP
iptables -A FORWARD -i eth0 -s 192.168.0.0/16 -j DROP

# --- E. Start Services ---
sed -i 's/INTERFACESv4=""/INTERFACESv4="eth0"/' /etc/default/isc-dhcp-server
/etc/init.d/isc-dhcp-server start

# **NEW: Enable OSPF Daemon**
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons

/etc/init.d/frr start