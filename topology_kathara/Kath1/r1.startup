# r1.startup

# --- A. Interface Setup ---
# Downlink to CSW1
ip link set dev eth0 up
ip addr add 10.0.0.33/30 dev eth0
ip -6 addr add 2001:db8:a1::/64 dev eth0 2>/dev/null || true

# Downlink to CSW2
ip link set dev eth1 up
ip addr add 10.0.0.37/30 dev eth1
ip -6 addr add 2001:db8:a2::/64 dev eth1 2>/dev/null || true

# Uplink to ISPA (DHCP Client)
ip link set dev eth2 up
dhclient eth2

# Uplink to ISPB (DHCP Client)
ip link set dev eth3 up
dhclient eth3

# --- B. Loopback ---
ip addr add 10.0.0.76/32 dev lo

# --- C. Routing ---
# IPv6 Routes (Bypassing error if needed)
ip -6 route add default via 2001:db8:a::1 metric 100 2>/dev/null || true
ip -6 route add default via 2001:db8:b::1 metric 200 2>/dev/null || true

# --- D. NAT Configuration (Matching ACL 2) ---
# Cisco: ip nat inside source list 2 ... overload
# We permit ONLY the subnets listed in ACL 2 to be masqueraded (NATed).

# 1. A-PC (10.1.0.0/24)
iptables -t nat -A POSTROUTING -s 10.1.0.0/24 -o eth2 -j MASQUERADE
iptables -t nat -A POSTROUTING -s 10.1.0.0/24 -o eth3 -j MASQUERADE

# 2. A-Phone (10.2.0.0/24)
iptables -t nat -A POSTROUTING -s 10.2.0.0/24 -o eth2 -j MASQUERADE
iptables -t nat -A POSTROUTING -s 10.2.0.0/24 -o eth3 -j MASQUERADE

# 3. B-PC (10.3.0.0/24)
iptables -t nat -A POSTROUTING -s 10.3.0.0/24 -o eth2 -j MASQUERADE
iptables -t nat -A POSTROUTING -s 10.3.0.0/24 -o eth3 -j MASQUERADE

# 4. B-Phone (10.4.0.0/24)
iptables -t nat -A POSTROUTING -s 10.4.0.0/24 -o eth2 -j MASQUERADE
iptables -t nat -A POSTROUTING -s 10.4.0.0/24 -o eth3 -j MASQUERADE

# 5. Wi-Fi (10.6.0.0/24)
iptables -t nat -A POSTROUTING -s 10.6.0.0/24 -o eth2 -j MASQUERADE
iptables -t nat -A POSTROUTING -s 10.6.0.0/24 -o eth3 -j MASQUERADE

# Static NAT for Server [Source 48]
iptables -t nat -A PREROUTING -d 203.0.113.113 -j DNAT --to-destination 10.5.0.4
iptables -t nat -A POSTROUTING -s 10.5.0.4 -j SNAT --to-source 203.0.113.113

# --- E. SSH Access Control (Matching ACL 1) ---
# Cisco: access-class 1 in (Permit 10.1.0.0/24, Deny others)

# 1. Allow SSH from 10.1.0.0/24
iptables -A INPUT -p tcp --dport 22 -s 10.1.0.0/24 -j ACCEPT

# 2. Drop SSH from everywhere else
iptables -A INPUT -p tcp --dport 22 -j DROP

# --- F. Start DHCP Server (LAN) ---
# dhcpd must listen on lo so relayed unicasts arriving at 10.0.0.76 are accepted.
# eth0/eth1 stay in the list for the directly-connected CSW L3 segments.
sed -i 's/INTERFACESv4=""/INTERFACESv4="eth0 eth1 lo"/' /etc/default/isc-dhcp-server
/etc/init.d/isc-dhcp-server start

# --- G. Start Routing ---
# **NEW: Enable OSPF Daemon**
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons

/etc/init.d/frr start