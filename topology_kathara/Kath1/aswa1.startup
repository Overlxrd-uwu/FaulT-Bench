#!/bin/bash
# aswa1.startup — VLAN-aware bridge model (was: legacy brctl + subinterface)
# eth0 = mgmt client (VLAN 99 access), eth1 = laptop1 (VLAN 40 access, was LWAP1),
# eth2 = trunk to DSW-A1, eth3 = trunk to DSW-A2.

for i in 0 1 2 3; do ip link set dev eth$i up; done

ip link add name br0 type bridge vlan_filtering 1 vlan_default_pvid 0 stp_state 1
ip link set br0 up

# Access port: eth0 -> VLAN 99 (mgmt client per Cisco)
ip link set eth0 master br0
bridge vlan del dev eth0 vid 1 2>/dev/null
bridge vlan add dev eth0 vid 99 pvid untagged

# Access port: eth1 -> VLAN 40 (laptop1; was LWAP1 port — WLC not modeled)
ip link set eth1 master br0
bridge vlan del dev eth1 vid 1 2>/dev/null
bridge vlan add dev eth1 vid 40 pvid untagged

# Trunk ports: eth2, eth3 (uplinks to DSW-A1, DSW-A2)
for trunk in eth2 eth3; do
  ip link set $trunk master br0
  bridge vlan del dev $trunk vid 1 2>/dev/null
  for vid in 10 20 40 99; do bridge vlan add dev $trunk vid $vid; done
done

# Self port for VLAN 99 (for mgmt SVI)
bridge vlan add dev br0 vid 99 self

# Mgmt SVI (IP assigned by FRR from frr.conf)
ip link add link br0 name br0.99 type vlan id 99
ip link set br0.99 up

/etc/init.d/frr start
